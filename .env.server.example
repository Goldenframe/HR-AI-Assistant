# Copy to .env.server on the Linux server; Docker Compose >= 2.30 is required.
# Use the local bot's current token only after stopping its local process.
TELEGRAM_BOT_TOKEN=
AI_BASE_URL=http://127.0.0.1:62432/v1
AI_API_KEY=
AI_MODEL=Qwen3-Coder-Next
# No Jira/Confluence keys or real corporate roster are needed for this demo.
