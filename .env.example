# Optional settings: copy this file to .env. The app loads .env automatically.
# The Telegram token is also saved automatically after its first successful use.
# By default, rc-ai settings are read from the existing Hermes config.
# Set real values locally in the terminal, never commit them.
TELEGRAM_BOT_TOKEN=
AI_BASE_URL=http://127.0.0.1:62432/v1
AI_API_KEY=
AI_MODEL=Qwen3-Coder-Next

# Corporate colleague matching (Server/Data Center via Teleport).
TEAM_SOURCE=atlassian
TEAM_DIRECTORY=data/corporate-team.json
JIRA_URL=http://127.0.0.1:62452
JIRA_PERSONAL_TOKEN=
CONFLUENCE_URL=http://127.0.0.1:62451
CONFLUENCE_PERSONAL_TOKEN=

# Каталог действующих сотрудников TRCK; один раз python tracker-login.py
DIRECTORY_SOURCE=trck
TRCK_API_URL=https://trck.rdclr.ru
